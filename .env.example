# Copy to .env and fill in the keys you have. .env is gitignored; never commit real keys.

# LLM backends (one is needed to run the agents)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BENCHMARK_PROVIDER=gemini

# Optional tool keys. Every tool in keyless_registry() works without these.
# https://api.nasa.gov - falls back to the shared DEMO_KEY (30 requests/hour)
NASA_API_KEY=
# Raises the GitHub limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Required only by openweathermap and news_headlines (full_registry())
OPENWEATHERMAP_API_KEY=
NEWSAPI_KEY=

# Set to 1 to serve every public API from its recorded mock response
TOOLLLM_OFFLINE=
